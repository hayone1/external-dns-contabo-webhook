# Copy this file to .env and fill it in. .env is ignored by git.
#   cp .env.example .env

# Contabo API credentials (https://my.contabo.com/api/details)
CONTABO_CLIENT_ID=INT-12345678
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=you@example.com
CONTABO_API_PASSWORD=

# Webhook settings for `make run` and `make check-config`
DOMAIN_FILTER=example.com
LOG_LEVEL=debug

# End-to-end test (test/e2e/run.sh)
E2E_ZONE=example.com
